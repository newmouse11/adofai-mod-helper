<Window x:Class="AdofaiModHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADOFAI Mod Helper" Width="1000" Height="680" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource FontSans}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Typography.NumeralAlignment="Tabular">

  <Window.Resources>
    <!-- 헤더 언어 전환: 텍스트형 버튼 (활성은 기본 텍스트색, 비활성은 3단계 회색) -->
    <Style x:Key="LangButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <DataTemplate x:Key="InstalledRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="56"/>
          <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="{DynamicResource S.Update}" Style="{StaticResource Small}" HorizontalAlignment="Right"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" Click="OnUpdateOne"/>
        <CheckBox Grid.Column="3" Style="{StaticResource Switch}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggle"
                  AutomationProperties.Name="{Binding Name}"/>
        <Button Grid.Column="4" Style="{StaticResource Btn.Ghost}" Width="32" Height="32" Padding="0"
                ToolTip="{DynamicResource S.Delete}" AutomationProperties.Name="{DynamicResource S.Delete}" Click="OnRemove">
          <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
        </Button>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="StoreRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="112"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
            <Border Background="{StaticResource BgElevated}" CornerRadius="2" Padding="6,0" Height="20" Margin="8,0,0,0"
                    Visibility="{Binding IsLibrary, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{DynamicResource S.Library}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Style="{StaticResource Btn.Secondary}"
                Height="32" Padding="12,0" FontSize="12" HorizontalAlignment="Right" Click="OnStoreAction"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PickRow">
      <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="OnPickChanged">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
          <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding AutoNote}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"
                     Visibility="{Binding HasAutoNote, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </CheckBox>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 헤더 -->
    <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LangKo" Content="한국어" Style="{StaticResource LangButton}" Click="OnLangKo"/>
          <TextBlock Text="|" Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center" FontSize="12"/>
          <Button x:Name="LangEn" Content="English" Style="{StaticResource LangButton}" Click="OnLangEn"/>
        </StackPanel>
        <TextBlock Text="ADOFAI Mod Helper" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="1">
      <!-- 작업 진행: 전체 화면 스피너 대신 하단의 얇은 진행 줄 -->
      <Border x:Name="BusyPanel" DockPanel.Dock="Bottom" Background="{StaticResource BgCard}" Visibility="Collapsed">
        <StackPanel>
          <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Maximum="100"/>
          <TextBlock x:Name="BusyText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="16,8"
                     AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Border>

      <Grid x:Name="ContentRoot">
        <!-- ===== 첫 실행 마법사 ===== -->
        <Grid x:Name="WizardView" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Bottom">
            <Grid Margin="0,0,24,0">
              <TextBlock x:Name="Step1Label" Margin="0,0,0,10"><Run Text="1  "/><Run Text="{DynamicResource S.Step1}"/></TextBlock>
              <Border x:Name="Step1Bar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Primary}"/>
            </Grid>
            <Grid Margin="0,0,24,0">
              <TextBlock x:Name="Step2Label" Margin="0,0,0,10"><Run Text="2  "/><Run Text="{DynamicResource S.Step2}"/></TextBlock>
              <Border x:Name="Step2Bar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Primary}"/>
            </Grid>
            <Grid>
              <TextBlock x:Name="Step3Label" Margin="0,0,0,10"><Run Text="3  "/><Run Text="{DynamicResource S.Step3}"/></TextBlock>
              <Border x:Name="Step3Bar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Primary}"/>
            </Grid>
          </StackPanel>

          <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1"
                  Padding="24,20">
            <Grid MaxWidth="760" HorizontalAlignment="Left">
              <!-- 1단계 -->
              <StackPanel x:Name="WizardStep1">
                <TextBlock Text="{DynamicResource S.W1.Title}" Style="{StaticResource T.Title}"/>
                <TextBlock x:Name="W1Message" Style="{StaticResource T.Body}" Margin="0,8,0,16"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{DynamicResource S.LocateGame}" Style="{StaticResource Btn.Secondary}"
                          Margin="8,0,0,0" Click="OnLocateGame"/>
                  <Border Background="{StaticResource BgCard}" CornerRadius="4" Height="40" Padding="12,0">
                    <TextBlock x:Name="W1Path" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Border>
                </DockPanel>
                <StackPanel x:Name="W1Warning" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}" Margin="0,0,8,0"/>
                  <TextBlock Text="{DynamicResource S.B.NonAscii}" Style="{StaticResource T.Body}" FontSize="12" MaxWidth="700"/>
                </StackPanel>
              </StackPanel>

              <!-- 2단계 -->
              <StackPanel x:Name="WizardStep2" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource S.W2.Title}" Style="{StaticResource T.Title}"/>
                <TextBlock Text="{DynamicResource S.W2.Body}" Style="{StaticResource T.Body}" Margin="0,8,0,16"/>
                <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="12,10">
                  <DockPanel>
                    <TextBlock Text="UMM" Style="{StaticResource T.Label}" Width="56" VerticalAlignment="Center"/>
                    <TextBlock x:Name="W2Status" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </DockPanel>
                </Border>
                <StackPanel x:Name="W2Warning" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}" Margin="0,0,8,0"/>
                  <TextBlock x:Name="W2WarningText" Style="{StaticResource T.Body}" FontSize="12" MaxWidth="700"/>
                </StackPanel>
              </StackPanel>

              <!-- 3단계 -->
              <DockPanel x:Name="WizardStep3" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.W3.Title}" Style="{StaticResource T.Title}"/>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.W3.Body}" Style="{StaticResource T.Body}" Margin="0,8,0,12"/>
                <TextBlock x:Name="W3Loading" DockPanel.Dock="Top" Text="{DynamicResource S.W3.Loading}" Style="{StaticResource T.Label}"/>
                <ListBox x:Name="PickList" Style="{StaticResource List}" ItemTemplate="{StaticResource PickRow}" Margin="-16,0"/>
              </DockPanel>
            </Grid>
          </Border>

          <DockPanel Grid.Row="2" Margin="24,0" VerticalAlignment="Center">
            <Button x:Name="WizardBack" Content="{DynamicResource S.Back}" Style="{StaticResource Btn.Ghost}" Click="OnWizardBack"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="WizardSkip" Content="{DynamicResource S.Skip}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Click="OnWizardSkip"/>
              <Button x:Name="WizardSecondary" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Click="OnWizardSecondary"/>
              <Button x:Name="WizardPrimary" Style="{StaticResource Btn.Primary}" MinWidth="120" Click="OnWizardPrimary"/>
            </StackPanel>
          </DockPanel>
        </Grid>

        <!-- ===== 메인 화면 ===== -->
        <Grid x:Name="MainView" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
          </Grid.RowDefinitions>

          <!-- 상태줄 -->
          <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource S.Game}" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="GamePathText" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                <Button Content="{DynamicResource S.Change}" Style="{StaticResource Small}" Margin="12,0,0,0" Click="OnLocateGame"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="UMM" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="UmmStatusText" VerticalAlignment="Center"/>
                <TextBlock x:Name="UmmLatestText" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button x:Name="UmmActionButton" Style="{StaticResource Small}" Margin="12,0,0,0" Click="OnUmmAction"/>
              </StackPanel>
              <Button Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Btn.Secondary}" VerticalAlignment="Center" Click="OnLaunch">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                  <TextBlock Text="{DynamicResource S.LaunchGame}"/>
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- 알림 배너 -->
          <ItemsControl x:Name="BannerList" Grid.Row="1">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PrimaryTint}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                  <DockPanel>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Actions}" VerticalAlignment="Center" Margin="16,0,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Label}" Style="{StaticResource Btn.Secondary}" Height="32" Padding="12,0"
                                  FontSize="12" Margin="8,0,0,0" Click="OnBannerAction"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 탭 -->
          <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,4,16,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <Button Content="{DynamicResource S.Refresh}" Style="{StaticResource SmallGhost}" Click="OnRefresh"/>
                <Button x:Name="UpdateAllButton" Content="{DynamicResource S.UpdateAll}" Style="{StaticResource Btn.Primary}"
                        Height="32" Padding="12,0" FontSize="12" Margin="8,0,0,0" Visibility="Collapsed" Click="OnUpdateAll"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabInstalled" Style="{StaticResource Tab}" GroupName="Tabs" IsChecked="True" Checked="OnTabChanged">
                  <TextBlock><Run Text="{DynamicResource S.Tab.Installed}"/><Run x:Name="InstalledCount" Foreground="{StaticResource TextTertiary}"/></TextBlock>
                </RadioButton>
                <RadioButton x:Name="TabStore" Style="{StaticResource Tab}" GroupName="Tabs" Checked="OnTabChanged">
                  <TextBlock><Run Text="{DynamicResource S.Tab.Store}"/><Run x:Name="StoreCount" Foreground="{StaticResource TextTertiary}"/></TextBlock>
                </RadioButton>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- 목록 -->
          <Grid Grid.Row="3" Background="{StaticResource BgSurface}">
            <ListBox x:Name="InstalledList" Style="{StaticResource List}" ItemTemplate="{StaticResource InstalledRow}"/>
            <ListBox x:Name="StoreList" Style="{StaticResource List}" ItemTemplate="{StaticResource StoreRow}" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Visibility="Collapsed"/>
          </Grid>

          <!-- 하단 -->
          <Border Grid.Row="4" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource S.Help}" Style="{StaticResource SmallGhost}" Click="OnHelp"/>
                <Button Content="{DynamicResource S.Contact}" Style="{StaticResource SmallGhost}" Click="OnContact"/>
                <Button Content="GitHub" Style="{StaticResource SmallGhost}" Click="OnGitHub"/>
                <TextBlock Text="|" Foreground="{StaticResource TextDisabled}" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                <Button x:Name="SelfUpdateButton" Style="{StaticResource SmallGhost}" Foreground="{StaticResource Info}" Visibility="Collapsed" Click="OnSelfUpdate"/>
                <TextBlock x:Name="AppVersionText" FontSize="12" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="8,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource S.CopyDiag}" Style="{StaticResource SmallGhost}" Click="OnCopyDiagnostics"/>
                <Button Content="{DynamicResource S.RemoveUmm}" Style="{StaticResource SmallGhost}" Click="OnRemoveUmm"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- 토스트: 오른쪽 아래, 최대 3개 -->
    <StackPanel x:Name="Toasts" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,16,16,56"
                AutomationProperties.LiveSetting="Polite"/>

    <!-- 확인창 -->
    <Grid x:Name="DialogLayer" Grid.RowSpan="2" Background="{StaticResource Overlay}" Visibility="Collapsed">
      <Border Background="{StaticResource BgCard}" CornerRadius="8" MaxWidth="480" Padding="20" Margin="16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.48" Color="{StaticResource ShadowColor}"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="Medium"/>
          <TextBlock x:Name="DialogBody" Style="{StaticResource T.Body}" Margin="0,12,0,20"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DialogCancel" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Click="OnDialogCancel"/>
            <Button x:Name="DialogAlt" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Visibility="Collapsed" Click="OnDialogAlt"/>
            <Button x:Name="DialogConfirm" Style="{StaticResource Btn.Primary}" MinWidth="88" Click="OnDialogConfirm"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
