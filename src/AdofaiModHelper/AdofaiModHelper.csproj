<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 윈도우 10(1903+)/11에 기본 내장된 .NET Framework 4.8 → 유저는 런타임 설치 불필요 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>AdofaiModHelper</AssemblyName>
    <RootNamespace>AdofaiModHelper</RootNamespace>
    <Version>1.1.0</Version>
    <Product>ADOFAI Mod Helper</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 외부 DLL 없이 exe 하나로 배포하기 위해 pdb도 exe에 넣는다 -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 글꼴은 exe 안에 WPF 리소스로, 모드 목록은 오프라인 대비 내장 사본으로 -->
    <Resource Include="Fonts\*.ttf" />
    <EmbeddedResource Include="..\..\catalog\mods.json" LogicalName="mods.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <!-- System.Web.Extensions가 의존해서 XAML 컴파일러(MC1000)가 요구한다 -->
    <Reference Include="System.Web" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

</Project>
